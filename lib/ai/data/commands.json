[
  {
    "name": "fetch",
    "signature": "fetch <source>, from: -<duration>",
    "category": "data-loading",
    "description": "Load data from a source (logs, events, spans, metrics, bizevents).",
    "example": "fetch logs, from: -24h"
  },
  {
    "name": "data",
    "signature": "data <json>",
    "category": "data-loading",
    "description": "Generate sample records inline for testing.",
    "example": "data [{\"id\": 1, \"name\": \"test\"}]"
  },
  {
    "name": "fieldsKeep",
    "signature": "fields <col1>, <col2>",
    "category": "data-shaping",
    "description": "Keep only the specified columns.",
    "example": "fields timestamp, loglevel, content"
  },
  {
    "name": "fieldsAdd",
    "signature": "fieldsAdd <col> = <expr>",
    "category": "data-shaping",
    "description": "Add computed columns.",
    "example": "fieldsAdd error_flag = loglevel == \"ERROR\""
  },
  {
    "name": "fieldsRemove",
    "signature": "fieldsRemove <col1>, <col2>",
    "category": "data-shaping",
    "description": "Remove columns from the dataset.",
    "example": "fieldsRemove internal_id, raw_bytes"
  },
  {
    "name": "fieldsRename",
    "signature": "fieldsRename <old> = <new>",
    "category": "data-shaping",
    "description": "Rename existing columns.",
    "example": "fieldsRename src = log.source"
  },
  {
    "name": "parse",
    "signature": "parse <field>, \"<pattern>\"",
    "category": "data-shaping",
    "description": "Extract structured data from text using typed capture groups.",
    "example": "parse content, \"INT:http_status\""
  },
  {
    "name": "expand",
    "signature": "expand <array_col>",
    "category": "data-shaping",
    "description": "Turn array values into separate rows.",
    "example": "expand tags"
  },
  {
    "name": "dedup",
    "signature": "dedup <field>",
    "category": "data-shaping",
    "description": "Remove duplicate rows based on a field.",
    "example": "dedup trace_id"
  },
  {
    "name": "filter",
    "signature": "filter <condition>",
    "category": "filtering",
    "description": "Keep rows matching a boolean condition.",
    "example": "filter loglevel == \"ERROR\""
  },
  {
    "name": "filterOut",
    "signature": "filterOut <condition>",
    "category": "filtering",
    "description": "Remove rows matching a condition (keeps nulls).",
    "example": "filterOut status == \"healthy\""
  },
  {
    "name": "search",
    "signature": "search \"<term>\"",
    "category": "filtering",
    "description": "Token-based case-insensitive full-text search across all fields.",
    "example": "search \"timeout\""
  },
  {
    "name": "sort",
    "signature": "sort <field> [asc|desc]",
    "category": "aggregation",
    "description": "Sort rows by a field. Place this last for performance.",
    "example": "sort timestamp desc"
  },
  {
    "name": "limit",
    "signature": "limit <n>",
    "category": "aggregation",
    "description": "Cap the result count. Use after summarize.",
    "example": "limit 10"
  },
  {
    "name": "summarize",
    "signature": "summarize <agg>, by:{<field>}",
    "category": "aggregation",
    "description": "Group and aggregate data.",
    "example": "summarize count = count(), by:{host}"
  },
  {
    "name": "makeTimeseries",
    "signature": "makeTimeseries <alias> = <agg>, interval:<duration>",
    "category": "aggregation",
    "description": "Aggregate into time buckets.",
    "example": "makeTimeseries errors = count(), interval: 5m"
  },
  {
    "name": "append",
    "signature": "append [subquery]",
    "category": "joining",
    "description": "Union with results from a subquery.",
    "example": "append (fetch events)"
  },
  {
    "name": "join",
    "signature": "join [subquery], on:<condition>",
    "category": "joining",
    "description": "Merge with subquery results on a condition.",
    "example": "join (fetch events), on:{trace_id}"
  }
]
