[
  {
    "type": "boolean",
    "description": "Logical true / false values.",
    "examples": ["true", "false", "TRUE", "FALSE"],
    "notes": "Case-insensitive. null == null yields null, not true."
  },
  {
    "type": "long",
    "description": "Signed 64-bit integers.",
    "examples": ["42", "-7", "0xFF"],
    "notes": "Hex literals supported. Use toLong() for conversion."
  },
  {
    "type": "double",
    "description": "64-bit IEEE 754 floating-point.",
    "examples": ["3.14159", "-0.001", "1e10"],
    "notes": "Use toDouble() for conversion."
  },
  {
    "type": "timestamp",
    "description": "Nanosecond precision instant in UTC.",
    "examples": ["2024-01-15T08:30:00Z"],
    "notes": "Can be compared and formatted."
  },
  {
    "type": "duration",
    "description": "Relative time spans.",
    "examples": ["1s", "1m", "1h", "1d", "1w", "1M", "1y"],
    "notes": "Used in fetch timeframes and interval arguments."
  },
  {
    "type": "string",
    "description": "UTF-8 text sequences.",
    "examples": ["\"hello\"", "\"line1\\nline2\""],
    "notes": "Double quotes. Triple-quote for multiline blocks."
  },
  {
    "type": "IpAddress",
    "description": "IPv4 or IPv6 network address.",
    "examples": ["\"192.168.1.1\"", "\"::1\""],
    "notes": "Supports comparison and CIDR matching."
  },
  {
    "type": "UID",
    "description": "64-bit or 128-bit identifiers.",
    "examples": ["\"0x1234567890abcdef\""],
    "notes": "Used for entity IDs and trace IDs."
  },
  {
    "type": "array",
    "description": "Ordered collection of values.",
    "examples": ["[1, 2, 3]", "[\"a\", \"b\"]"],
    "notes": "Index access: a[0]"
  },
  {
    "type": "record",
    "description": "Key-value pairs (nested objects).",
    "examples": ["{\"name\": \"server\", \"cpu\": 45}"],
    "notes": "Field access: r[field]"
  }
]
